<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>not DB but likes DB</title>
    <style>
        body{
            text-decoration-color: blanchedalmond;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="main  w-full min-h-screen bg-zinc-900">
        <div class="form p-10">
            <form action="/create" method="post"> 
                <input class=" text-blue block w-full rounded-md mt-2 px-5 py-2 bg-sinc-800" type="text" placeholder="tittle goes here" name="title">
                <textarea class="mt-2 w-full  rounded-md block px-5 py-2 bg-sinc-800"  id="" placeholder="write your taks detaials here " name="details"></textarea>
                <input type="submit" value="create task " class="mt-2 bg-blue-600 px-5 py-2 rounded-md">
            </form>
        </div>
        <div class="tasks flex gap-3 flex-wrap p-10">
            <% if(files.length > 0) { %>
                <% files.forEach((val) => { %>
                    <div class="task w-72 px-3 rounded-md bg-zinc-800">
                        <h1 class="text-white text-3xl tracking-tighter"><%= val %></h1>
                        <div class="flex w-full justify-between mt-3 items-center">
                        <a  class="text-blue-500 inline-block " href="/file/<%= val %>">Read More</a>
                        <a class="text-zinc-600 px-4" href="/edit/<%= val %>"> edit filename</a>
                    </div>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-white">NO TASK YET</h3>
            <% } %>
            
            
        </div>
    </div>
</body>
</html>